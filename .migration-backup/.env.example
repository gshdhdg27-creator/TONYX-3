# ─────────────────────────────────────────────────────────────────
#  TONYX — Environment Variables Reference
#  Copy this file to api-server/.env and fill in real values.
#  On Vercel: add each variable in Project → Settings → Environment Variables.
#  On Replit: add each variable via the Secrets panel.
# ─────────────────────────────────────────────────────────────────

# ── DATABASE ─────────────────────────────────────────────────────
# NEON_DATABASE_URL takes priority over DATABASE_URL when both are set.
DATABASE_URL="postgresql://user:password@host:5432/dbname"
NEON_DATABASE_URL="postgresql://user:password@ep-xxx.neon.tech/neondb?sslmode=require"

# ── TELEGRAM BOT ─────────────────────────────────────────────────
# BotFather token — required for /start, user notifications, daily stats.
TELEGRAM_BOT_TOKEN="123456789:AABBccDDeeFF..."

# Bot username (without @), used for referral links.
BOT_USERNAME="YourBotUsername_bot"

# Set to "true" in dev to run bot polling locally.
# Only one polling consumer per token is allowed — don't run dev & prod simultaneously.
BOT_ENABLED="false"

# ── ADMIN ────────────────────────────────────────────────────────
# Comma-separated Telegram IDs with access to /api/mini/admin/*.
# First ID is the OWNER (cannot be banned/reset).
ADMIN_TELEGRAM_IDS="7257793582"

# ── TON PROJECT WALLET ───────────────────────────────────────────
# The project's TON wallet address that receives user deposits.
# Shown in the profile deposit panel and used by the deposit scanner.
PROJECT_WALLET_ADDRESS="UQA8d39yaqa-CGw6BUCQw6U3LGelzpS3GxFaVwVDY3BnCDwe"

# 24-word BIP39 mnemonic for the project wallet.
# REQUIRED for automatic TON withdrawals (autoSendTon in wallet.ts).
# If not set: withdrawals are queued as "pending" for manual admin processing.
# ⚠️  KEEP SECRET — never commit or expose this value.
PROJECT_WALLET_MNEMONIC="word1 word2 word3 ... word24"

# ── TON BLOCKCHAIN API ───────────────────────────────────────────
# TonAPI key (tonapi.io) — used by the deposit scanner (depositScanner.ts)
# and the manual verify endpoint (wallet.ts → queryProjectWalletTxs).
# Without a key the scanner still works but may hit public rate limits.
TONAPI_KEY=""

# TonCenter API key (toncenter.com) — optional fallback RPC provider.
TONCENTER_API_KEY=""

# Custom TON JSON-RPC endpoint — leave blank to use the default mainnet endpoint.
# Default: https://toncenter.com/api/v2/jsonRPC
TON_RPC_URL=""

# ── VERCEL CRON ──────────────────────────────────────────────────
# Secret token used to authenticate Vercel Cron requests to POST /api/mini/wallet/scan.
# Vercel automatically sends this as: Authorization: Bearer <CRON_SECRET>
# Generate with: openssl rand -hex 32
# Add this value in Vercel → Project → Settings → Environment Variables.
CRON_SECRET="your-random-secret-here"

# ── APP ──────────────────────────────────────────────────────────
# Public URL of the deployed mini-app (used in bot /start keyboard button).
WEBAPP_URL="https://your-app.vercel.app/mini-app/"

# Node environment — set to "production" on Vercel/server.
NODE_ENV="development"

# Log verbosity: "debug" | "info" | "warn" | "error"
LOG_LEVEL="info"

# Server port for the API (default: 3001).
PORT="3001"
API_PORT="3001"
