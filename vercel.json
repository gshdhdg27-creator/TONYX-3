{
  "installCommand": "pnpm install --no-frozen-lockfile",
  "buildCommand": "node scripts/bundle-api.mjs && pnpm --filter @workspace/mini-app run build",
  "outputDirectory": "artifacts/mini-app/dist/public",
  "framework": null,
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/server" }
  ],
  "functions": {
    "api/server.ts": { "maxDuration": 30 }
  },
  "crons": [
    {
      "path": "/api/cron/scan-deposits",
      "schedule": "0 12 * * *"
    }
  ]
}
