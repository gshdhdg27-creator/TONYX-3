modules = ["nodejs-20", "web", "postgresql-16"]
[agent]
expertMode = true
stack = "BEST_EFFORT_FALLBACK"

[nix]
channel = "stable-25_05"

[workflows]

[[ports]]
localPort = 3001
externalPort = 3001

[[ports]]
localPort = 5000
externalPort = 5000

[[ports]]
localPort = 8080
externalPort = 80

[[ports]]
localPort = 18801
externalPort = 3000

[deployment]
deploymentTarget = "vm"
run = ["bash", "-c", "npx concurrently \"PORT=3001 node api-server/dist/index.js\" \"cd mini-app && npx serve -l 5000 dist/public\""]
build = ["bash", "-c", "pnpm install && pnpm run build"]

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 120000

[userenv]

[userenv.shared]
API_PORT = "8080"
