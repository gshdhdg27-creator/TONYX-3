# ─────────────────────────────────────────────────────────────────
#  TONYX API Server — Environment Variables
#  Copy to api-server/.env and fill in real values before deploying.
#  On Vercel: add each variable in Project → Settings → Environment Variables.
# ─────────────────────────────────────────────────────────────────

# ── DATABASE ─────────────────────────────────────────────────────
# Primary PostgreSQL connection (Neon, Supabase, or any Postgres URL).
# NEON_DATABASE_URL takes priority over DATABASE_URL if both are set.
DATABASE_URL="postgresql://user:password@host:5432/dbname"
# NEON_DATABASE_URL="postgresql://user:password@ep-xxx.neon.tech/neondb?sslmode=require"

# ── TELEGRAM BOT ─────────────────────────────────────────────────
# BotFather token — REQUIRED for /start, daily stats, user notifications.
TELEGRAM_BOT_TOKEN="123456789:AABBccDDeeFF..."

# Bot username (without @), used for referral links.
BOT_USERNAME="YourBotUsername_bot"

# Set to "true" in dev if you want to test the bot locally (only one
# polling consumer is allowed per token — don't run both dev & prod).
BOT_ENABLED="false"

# ── TELEGRAM ADMIN ───────────────────────────────────────────────
# Comma-separated Telegram IDs that have admin access to /api/mini/admin/*.
# The first ID is treated as OWNER (cannot be banned/reset).
ADMIN_TELEGRAM_IDS="7257793582"

# ── TON PROJECT WALLET ───────────────────────────────────────────
# The project's TON wallet address that receives user deposits.
# Used by the deposit scanner and shown in the profile deposit panel.
PROJECT_WALLET_ADDRESS="UQA8d39yaqa-CGw6BUCQw6U3LGelzpS3GxFaVwVDY3BnCDwe"

# 24-word BIP39 mnemonic for the project wallet.
# REQUIRED for automatic TON withdrawals (autoSendTon).
# If not set: withdrawals are queued as "pending" for manual processing.
# ⚠️  KEEP SECRET — never commit or expose this value.
PROJECT_WALLET_MNEMONIC="word1 word2 word3 word4 word5 word6 word7 word8 word9 word10 word11 word12 word13 word14 word15 word16 word17 word18 word19 word20 word21 word22 word23 word24"

# Legacy alias for PROJECT_WALLET_MNEMONIC (some older code may read this).
ADMIN_WALLET_MNEMONIC=""

# ── TON BLOCKCHAIN API ───────────────────────────────────────────
# TonAPI key (tonapi.io) — used by the deposit scanner.
# Without a key the scanner still works but may hit rate limits.
TONAPI_KEY=""

# Alternative Toncenter API key (toncenter.com) — optional fallback.
TONCENTER_API_KEY=""

# Alternative TON API key (generic name used in some modules).
TON_API_KEY=""

# Custom TON RPC endpoint — leave blank to use the default mainnet endpoint.
TON_RPC_URL=""
TON_ENDPOINT=""

# ── APP ──────────────────────────────────────────────────────────
# Public URL of the deployed mini-app (used in bot /start keyboard button).
# On Vercel this is your *.vercel.app URL or custom domain.
WEBAPP_URL="https://your-app.vercel.app/mini-app/"

# Node environment — set to "production" on Vercel/server.
# In production the Telegram bot polling starts automatically.
NODE_ENV="production"

# Verbosity: "debug" | "info" | "warn" | "error"
LOG_LEVEL="info"
